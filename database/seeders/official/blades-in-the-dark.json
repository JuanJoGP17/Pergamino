                        {
                            "key": "valor_perspicacia",
                            "label": "Perspicacia (resistir)",
                            "type": "computed",
                            "col_span": 4,
                            "config": [],
                            "default_value": null,
                            "formula": "if(@perspicacia.cazar.bonus > 0, 1, 0) + if(@perspicacia.estudiar.bonus > 0, 1, 0) + if(@perspicacia.examinar.bonus > 0, 1, 0) + if(@perspicacia.trastear.bonus > 0, 1, 0)",
                            "roll_expression": "{@valor_perspicacia}d6",
                            "visible_if": null,
                            "readonly_if": null,
                            "help_text": null,
                            "is_summary": false,
                            "is_required": false
                        },
                        {
                            "key": "valor_proeza",
                            "label": "Proeza (resistir)",
                            "type": "computed",
                            "col_span": 4,
                            "config": [],
                            "default_value": null,
                            "formula": "if(@proeza.sutileza.bonus > 0, 1, 0) + if(@proeza.merodear.bonus > 0, 1, 0) + if(@proeza.escaramuza.bonus > 0, 1, 0) + if(@proeza.destrozar.bonus > 0, 1, 0)",
                            "roll_expression": "{@valor_proeza}d6",
                            "visible_if": null,
                            "readonly_if": null,
                            "help_text": null,
                            "is_summary": false,
                            "is_required": false
                        },
                        {
                            "key": "valor_determinacion",
                            "label": "Determinación (resistir)",
                            "type": "computed",
                            "col_span": 4,
                            "config": [],
                            "default_value": null,
                            "formula": "if(@determinacion.sintonizar.bonus > 0, 1, 0) + if(@determinacion.ordenar.bonus > 0, 1, 0) + if(@determinacion.codearse.bonus > 0, 1, 0) + if(@determinacion.persuadir.bonus > 0, 1, 0)",
